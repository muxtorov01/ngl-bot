# Telegram
BOT_TOKEN=123456:ABC-DEF...          # from @BotFather
BOT_USERNAME=my_anonymous_bot        # without the @

# Database (Render provides this automatically if you attach a Postgres instance)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Webhook
WEBHOOK_BASE_URL=https://your-service.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-a-random-string

# Server (Render injects PORT automatically)
PORT=8080

# Comma-separated Telegram user IDs who get super_admin role
SUPER_ADMIN_IDS=111111111,222222222

# Anti-spam
MAX_MSG_PER_WINDOW=3
ANTISPAM_WINDOW_SECONDS=30

# Media limits
MAX_VOICE_SECONDS=60
MAX_VOICE_BYTES=2097152
MAX_PHOTO_BYTES=10485760

LOG_LEVEL=INFO
